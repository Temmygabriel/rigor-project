# Rigor frontend — environment
#
# The deployed RigorBounty contract address on GenLayer studionet.
# Copy this file to `.env.local` for local dev, and set the same variable in
# Vercel's Project Settings -> Environment Variables for production.
#
# Default (if unset) falls back to the Studio-deployed contract whose admin key
# you control. Point this at your own deployment if you redeploy.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xa12c93B846A8525B00CF7fa812880541A1FA1d3f
